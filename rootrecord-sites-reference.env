# =============================================================================
# RootRecord — public reference env (main site + Solana site + Workers)
# Generated from committed config: rootrecord-website-main/, solana/solanasite/,
# cloudflare/rootrecord-primary/wrangler.toml, cloudflare/rootrecord-license/wrangler.toml.
#
# Use: copy lines into Cloudflare Pages/Workers vars, Vercel env, or local .env.
# Secrets (JWT, Stripe secret, SOLANA_SITE_LOG_SECRET, PINATA_JWT, treasury keys, etc.)
# are NOT listed here — keep those in credentials.env / dashboard secrets only.
# =============================================================================

# ---------------------------------------------------------------------------
# Main marketing + account site (rootrecord.info) — Cloudflare Pages
# Project name (wrangler): rootrecord-website
# ---------------------------------------------------------------------------
# Canonical public origin (HTML canonical / site-config behavior)
SITE_URL=https://rootrecord.info

# Pages Functions proxy upstream (rootrecord-website-main/wrangler.toml + functions/* defaults)
ROOTRECORD_API_BASE=https://rootrecord-primary.rootrecord.workers.dev

# Billing embed (same ids on Workers for parity — see wrangler [vars])
STRIPE_PRICING_TABLE_ID=prctbl_1TQJ0kIaRpbMiAovAUe3X3QJ
STRIPE_PUBLISHABLE_KEY=pk_live_51T3sezIaRpbMiAov6SUJgKLGR1igmRGOYg1rY1hKJPAWxLXDgJR7kRNSBSM8sJ2Wat1zuC56iE4TCTyPfqmEfTT600cR21LwYA
STRIPE_CUSTOMER_PORTAL_URL=https://billing.stripe.com/p/login/9B64gzaB73pb1wM7oH5gc00

# Lifetime checkout link (rootrecord-website-main/account.js — client-side)
STRIPE_LIFETIME_CHECKOUT_URL=https://buy.stripe.com/bJe3cvgZv5xj8ZecJ15gc05

# Stripe webhook target (license Worker — set endpoint in Stripe Dashboard to this URL)
STRIPE_WEBHOOK_ENDPOINT=https://rootrecord-license.rootrecord.workers.dev/v1/billing/webhook

# ---------------------------------------------------------------------------
# rootrecord-primary Worker (cloudflare/rootrecord-primary/wrangler.toml [vars])
# Worker name: rootrecord-primary
# ---------------------------------------------------------------------------
WORKER_PRIMARY_SITE_URL=https://rootrecord.info
WORKER_PRIMARY_STRIPE_PRICING_TABLE_ID=prctbl_1TQJ0kIaRpbMiAovAUe3X3QJ
WORKER_PRIMARY_STRIPE_PUBLISHABLE_KEY=pk_live_51T3sezIaRpbMiAov6SUJgKLGR1igmRGOYg1rY1hKJPAWxLXDgJR7kRNSBSM8sJ2Wat1zuC56iE4TCTyPfqmEfTT600cR21LwYA
# Template in repo — replace with live recurring Price id in Worker vars / wrangler before checkout:
STRIPE_PRICE_ID=price_REPLACE_WITH_YOUR_STRIPE_PRICE_ID
WORKER_PRIMARY_ACCUWEATHER_LANGUAGE=en-us
WORKER_PRIMARY_WEATHER_DATA_TTL_SEC=900
WORKER_PRIMARY_ACCUWEATHER_REUSE_RADIUS_MILES=25

# D1 binding name/id appear only in wrangler.toml (same DB for primary + license):
# database_name=root-record  database_id=0b49c598-1f91-4a09-84a8-6ba8241c6df3

# ---------------------------------------------------------------------------
# rootrecord-license Worker (cloudflare/rootrecord-license/wrangler.toml [vars])
# Worker name: rootrecord-license
# ---------------------------------------------------------------------------
WORKER_LICENSE_CORS_ALLOW_ORIGIN=*
WORKER_LICENSE_STRIPE_PRICING_TABLE_ID=prctbl_1TQJ0kIaRpbMiAovAUe3X3QJ
WORKER_LICENSE_STRIPE_PUBLISHABLE_KEY=pk_live_51T3sezIaRpbMiAov6SUJgKLGR1igmRGOYg1rY1hKJPAWxLXDgJR7kRNSBSM8sJ2Wat1zuC56iE4TCTyPfqmEfTT600cR21LwYA

# ---------------------------------------------------------------------------
# Solana tools site (solana/solanasite) — Vercel / Next.js
# Public hostname fallback (app/layout.tsx, lib/siteOrigin.ts)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://solana.rootrecord.info

# Portal + /v1 API for custodial login (lib/rootrecordSession.ts — set on Vercel for production)
# Use primary Worker URL (matches solana app copy in ecosystem/page.tsx guidance):
NEXT_PUBLIC_ROOTRECORD_API_BASE=https://rootrecord-primary.rootrecord.workers.dev

# Solana action log ingest (server → Worker; same path as ecosystem page copy)
SOLANA_SITE_LOG_URL=https://rootrecord-primary.rootrecord.workers.dev/api/solana-site/log

# Cluster + RPC defaults when unset (lib/solana.ts)
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
NEXT_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com

# Fee + referral defaults when unset (lib/solana.ts)
NEXT_PUBLIC_CREATE_FEE_SOL=0.025
NEXT_PUBLIC_ACTION_FEE_SOL=0.01
NEXT_PUBLIC_REFERRAL_SHARE_BPS=1000
NEXT_PUBLIC_LAUNCH_FEE_SOL=0.05
NEXT_PUBLIC_ADD_LIQUIDITY_FEE_SOL=0.005
NEXT_PUBLIC_REMOVE_LIQUIDITY_FEE_SOL=0.005
NEXT_PUBLIC_BULK_FEE_PER_100_SOL=0.01

# Pinata image host default (next.config.js remotePatterns — hostname only if you override)
NEXT_PUBLIC_PINATA_GATEWAY=gateway.pinata.cloud

# Ecosystem OTC defaults shipped in code (lib/ecosystemOtcConstants.ts) — override only if deployment differs
NEXT_PUBLIC_ECOSYSTEM_TOKEN_MINT=6KfGKe13ASrV5WHvChbapQXxxEFRNqwpwrdEVsX6RQMT
NEXT_PUBLIC_ECOSYSTEM_OTC_CPMM_POOL_ID=CJPypGffPA7xf9rPy7HhuLQSx7FZUpYgrSXYMuiTHuJr
NEXT_PUBLIC_ECOSYSTEM_SOLSCAN_TREASURY=3QG6gVk3fdimzQaKX9zf7J6kCs5DRLKg1RNea3VBosDJ
NEXT_PUBLIC_ECOSYSTEM_SOLSCAN_DEVELOPER=HCeCfMAAZeFUaBQrzC2t84myrBnvnb3h8M26k4urv2X1

# Optional Cloudflare Web Analytics (layout.tsx — leave empty if unused)
# NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=

