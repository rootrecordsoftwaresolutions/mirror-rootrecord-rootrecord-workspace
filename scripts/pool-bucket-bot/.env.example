# Same RPC / pool / wallet / sizing as pool-matcher-bot, plus bucket timing.

RPC_URL=
WALLET_PRIVATE_KEY=
POOL_ID=
TARGET_MINT=

# Wall-clock bucket length (seconds). 60 = one trade batch per minute.
BUCKET_SEC=60

POLL_INTERVAL_SEC=5
SLIPPAGE_BPS=120
MIN_MATCH_RAW=1

POOL_MATCH_INVERT=0
SIZING_MODE=auto
MIRROR_BUY_BPS=8500
AUTO_SELL_MAX_POOL_BPS=50
AUTO_BUY_BPS_MIN=1200
AUTO_BUY_BPS_MAX=10000
AUTO_BUY_CURVE=1.25

# Per-single-Jupiter-tx cap (same semantics as pool-matcher). Empty = 0.1 whole token.
# MAX_MIRROR_SELL_RAW=

# Optional extra cap on *aggregated* raw per bucket (0 = use 10x MAX_MIRROR micro default when set).
# BUCKET_MAX_SELL_RAW=
# BUCKET_MAX_BUY_RAW=

# JUPITER_API_KEY=

# Ecosystem Worker (see pool-matcher-bot .env.example); default ECOSYSTEM_BOT_ID=pool_bucket
# SOLANA_SITE_LOG_URL=
# SOLANA_SITE_LOG_SECRET=
# ECOSYSTEM_REINVEST_USD_THRESHOLD=20
# ECOSYSTEM_REINVEST_SOURCE=mirror_bot
