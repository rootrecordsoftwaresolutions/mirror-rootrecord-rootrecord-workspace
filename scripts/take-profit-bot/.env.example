RPC_URL=https://mainnet.helius-rpc.com/?api-key=
WALLET_PRIVATE_KEY=

# Token you hold (SPL mint)
TOKEN_MINT=

# What you swap into when taking profit / stop (usually WSOL or USDC)
QUOTE_MINT=So11111111111111111111111111111111111111112

# +25 means sell when Jupiter implied price is 25% above saved entry
TP_PCT=25
# 0 disables stop-loss; 15 means sell if 15% below entry
SL_PCT=0

# On trigger, sell this percent of current token balance (1-100)
SELL_PCT_OF_BALANCE=100

# How often to poll (seconds)
CHECK_INTERVAL_SEC=15

# After a successful sell, wait before checking again
COOLDOWN_AFTER_SELL_SEC=30

# Jupiter slippage for quotes + sells
SLIPPAGE_BPS=150

# Optional — paid Jupiter
# JUPITER_API_KEY=

# Skip price checks if balance below this raw amount (dust)
MIN_BALANCE_RAW=1
