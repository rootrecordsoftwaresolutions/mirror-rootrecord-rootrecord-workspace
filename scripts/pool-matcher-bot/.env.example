# Solana RPC (paid recommended for polling + send)
RPC_URL=https://mainnet.helius-rpc.com/?api-key=

# Base58-encoded 64-byte secret key (same as Phantom export)
WALLET_PRIVATE_KEY=

# Raydium CPMM pool id (same as Liquidity page)
# Optional: leave empty to auto-discover TARGET_MINT<->USDC Raydium CPMM pool and cache it.
POOL_ID=

# Fastest launch (explicit): paste pool ids for each base token (takes precedence over everything below).
POOL_ID_USDC=
POOL_ID_WSOL=

# Fastest multi-pool launch (fallback): paste comma-separated pool ids here (takes precedence over POOL_ID/discovery).
# POOL_IDS=poolIdForUSDC,poolIdForWSOL

# Mint you are inventory-managing (usually your project token)
TARGET_MINT=

# If you start the bot before the pool exists, set to 1 to keep retrying discovery until it appears.
# WAIT_FOR_POOLS=1
# DISCOVERY_POLL_SEC=2

# Print a periodic "still alive" line while watching pools (seconds). 0 disables.
# HEARTBEAT_SEC=30

# Single-pool mode: set POOL_ID (and optionally QUOTE_MINT for quoting/trades).
# Quote mint default: mainnet USDC
# QUOTE_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Multi-pool mode (recommended): if POOL_ID is empty, discover pools for these quote mints.
# Default if omitted: USDC + WSOL
# QUOTE_MINTS=USDC,WSOL

# Where to store discovered pool ids (json file); key is "TARGET:QUOTE" -> POOL_ID
# POOL_CACHE_PATH=pool_cache.json

# Jupiter: omit for https://lite-api.jup.ag ; set key for https://api.jup.ag
# JUPITER_API_KEY=

POLL_INTERVAL_SEC=5
SLIPPAGE_BPS=120
MIN_MATCH_RAW=1

# Detection robustness under high volume:
# How many signatures per RPC page to fetch per pool (newest-first). Higher = fewer misses, more RPC load.
# SIG_PAGE_LIMIT=100
# How many pages to fetch per poll cycle per pool when catching up.
# SIG_MAX_PAGES=5

# Sell this fraction of each detected pool buy-leg (bps). Example: 5000 = 50%.
MIRROR_SELL_BPS=10000

# Optional safety rails (0/off by default):
# Cap each mirror-sell to at most this % of *current wallet balance* (bps). Example: 2500 = 25%.
# MAX_SELL_PER_TRADE_WALLET_BPS=2500
# Cap total raw tokens sold during this bot run. Example: 1000000000 (raw units).
# MAX_SESSION_SELL_RAW=0

# Only mirror when token price >= this (USD), best-effort via Jupiter price probe.
# If price can't be fetched, the bot continues trading (treats as above threshold).
MIN_PRICE_USD=0.00001

# If the bot buys when your board shows a pool SELL (and vice versa), set to 1 to swap mirror direction.
# POOL_MATCH_INVERT=1

# SIZING_MODE=auto  (default) — caps mirror sells vs pool vault liquidity.
# SIZING_MODE=manual — sells only min(leg, wallet).

# Auto sell: max mirror sell = this fraction of pool TARGET-side vault. 50 = 0.5% (slow drip).
# AUTO_SELL_MAX_POOL_BPS=50

# Absolute cap per mirror sell (raw). Empty = 0.1 whole tokens from mint decimals. 0 = unlimited.
# MAX_MIRROR_SELL_RAW=

# --- Ecosystem Worker (D1 telemetry + optional reinvest queue) ---
# Same URL/secret as rootrecord site action logging (…/api/solana-site/log).
# SOLANA_SITE_LOG_URL=https://your-worker.workers.dev/api/solana-site/log
# SOLANA_SITE_LOG_SECRET=
# ECOSYSTEM_BOT_ID=pool_matcher
# When cumulative USDC-out from mirror *sells* (vs USDC pair) reaches this USD, POST a reinvest row.
# ECOSYSTEM_REINVEST_USD_THRESHOLD=20
# ECOSYSTEM_REINVEST_SOURCE=mirror_bot
