# Shared credentials for all apps under this workspace.
# Copy this file to `.env` in the SAME folder as `.rootrecord-workspace` (workspace root).
# Never commit `.env` (it is gitignored).

# --- Weather / mobile API (single Worker; auth + /api on same host) ---
# WEATHER_API_PUBLIC_URL=https://rootrecord-primary.rootrecord.workers.dev
# ROOTRECORD_PRIMARY_API=https://rootrecord-primary.rootrecord.workers.dev
# ROOTRECORD_CLIENT_ID=
# ROOTRECORD_CLIENT_SECRET=

# --- Example: database or service URLs ---
# ROOTRECORD_DATABASE_URL=

# Add any other variables your Electron apps expect; keep one source of truth here for local dev.
