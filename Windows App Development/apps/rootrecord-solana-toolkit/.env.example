# Copy to .env.local (Vite loads .env.local automatically)

# --- Solana (required for real txs) ---
VITE_SOLANA_NETWORK=mainnet-beta
VITE_RPC_URL=https://api.mainnet-beta.solana.com
VITE_FEE_WALLET=

# Fees (optional — match site defaults if empty)
# VITE_CREATE_FEE_SOL=0.025
# VITE_ACTION_FEE_SOL=0.01
# VITE_REFERRAL_SHARE_BPS=1000
# VITE_LAUNCH_FEE_SOL=0.05
# VITE_ADD_LIQUIDITY_FEE_SOL=0.005
# VITE_REMOVE_LIQUIDITY_FEE_SOL=0.005
# VITE_BULK_FEE_PER_100_SOL=0.01
# VITE_LAUNCH_USDC_MINT=

# --- IPFS (optional — for create + metadata images) ---
# VITE_PINATA_JWT=
# VITE_PINATA_GATEWAY=gateway.pinata.cloud

# --- Cloudflare Worker (optional — action log + recent tokens) ---
# VITE_WORKER_API_ORIGIN=https://your-worker.example.com
# VITE_SOLANA_SITE_LOG_SECRET=

# Canonical URL for referral link builder in success dialogs
# VITE_SITE_URL=http://localhost:5173
