{
  "name": "rootrecord-solana-toolkit",
  "version": "0.1.0",
  "type": "module",
  "description": "RootRecord Solana Tools — Windows desktop (Electron) suite matching solana.rootrecord.info",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@metaplex-foundation/mpl-token-metadata": "2.13.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@raydium-io/raydium-sdk-v2": "0.2.41-alpha",
    "@solana/spl-token": "^0.4.9",
    "@solana/spl-token-metadata": "^0.1.6",
    "@solana/wallet-adapter-base": "^0.9.23",
    "@solana/wallet-adapter-react": "^0.15.35",
    "@solana/wallet-adapter-react-ui": "^0.9.35",
    "@solana/wallet-adapter-wallets": "^0.19.32",
    "@solana/wallet-standard-wallet-adapter-react": "^1.1.4",
    "@solana/web3.js": "^1.95.4",
    "@streamflow/stream": "^11.4.0",
    "bn.js": "^5.2.0",
    "bs58": "^6.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^15.0.0",
    "react-hook-form": "^7.53.2",
    "react-qr-code": "^2.0.15",
    "react-router-dom": "^6.28.0",
    "sonner": "^1.7.0",
    "tailwind-merge": "^2.5.4",
    "tweetnacl": "^1.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.15",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "build": {
    "appId": "info.rootrecord.solana-toolkit",
    "productName": "RootRecord Solana Toolkit",
    "directories": { "output": "release" },
    "files": ["out/**/*", "package.json"],
    "win": {
      "target": ["nsis", "portable"]
    }
  }
}
